	partition Dim_Calendar = calculated
		mode: import
		source =
				
				ADDCOLUMNS (
				    CALENDARAUTO(),
				    "Year", YEAR([Date]),
				    "Quarter", "Q" & FORMAT([Date], "Q"),
				    "Month No", MONTH([Date]),
				    "Month", FORMAT([Date], "mmm", "en-US"),
				    "YearMonth", FORMAT([Date], "YYYY-MM")
				)

	annotation PBI_Id = 255b332e7878427bb4371c747024df91

