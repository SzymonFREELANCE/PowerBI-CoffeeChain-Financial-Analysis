table _Measures
	lineageTag: 4ffee4ed-aaaa-47a1-bc5d-32fd971373aa

	measure 'Total COGS' = SUM('Fact_Sales'[Cogs])
		formatString: \$#,0.0;(\$#,0.0);\$#,0.0
		displayFolder: 01 Base Metrics
		lineageTag: ab5011ab-4bfb-4667-89a7-76a75946f946

	measure 'Total Marketing' = SUM(Fact_Sales[Marketing])
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		displayFolder: 01 Base Metrics
		lineageTag: f92a54f9-d98f-4d44-a8af-5ff69d5cd870

	measure 'Net Profit' = [Gross Profit] - [Total Marketing]
		formatString: \$#,0.0;(\$#,0.0);\$#,0.0
		displayFolder: 01 Base Metrics
		lineageTag: 1d79fe92-357f-47fa-84f1-a2207c180e08

	measure 'Gross Margin %' = DIVIDE([Gross Profit], [Total Revenue], BLANK())
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 01 Base Metrics
		lineageTag: c83dbb57-19af-4970-ab29-6c1d24a16b28

	measure 'Profit Margin %' = DIVIDE([Net Profit], [Total Revenue], BLANK())
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 01 Base Metrics
		lineageTag: ede76d75-1426-41d9-b005-12c6f20af41f

	measure 'Target Revenue' = SUM(Fact_Targets[Target_sales])
		formatString: 0
		displayFolder: 01 Base Metrics
		lineageTag: 43653470-54ce-490a-8ac6-e0255a3c7e34

		changedProperty = IsHidden

	measure Revenue_Variance_Text =
			
			VAR Actual = [Total Revenue]
			VAR Target = [Target Revenue]
			VAR Pct = DIVIDE(Actual - Target, Target, BLANK())
			VAR SignPrefix = IF(Pct > 0, "+", "")
			VAR StatusText = IF(Pct >= 0, "above target", "below target")
			RETURN
			IF(
			    ISBLANK(Pct),
			    "N/A",
			    SignPrefix & FORMAT(Pct, "0.0%", "en-US") & " (" & StatusText & ")"
			)
		displayFolder: 02 Time Intelligence
		lineageTag: 2b98ce06-b68b-428a-8e1c-7c3353f19060

	measure 'Top Market Name' =
			
			MAXX(
			    TOPN(1, VALUES(Dim_Geography[Market]), [Total Revenue], DESC),
			    Dim_Geography[Market]
			)
		displayFolder: 03 Dynamic Text & Cards
		lineageTag: c90d36e5-35b5-4702-8f2a-e293b28626e9

	measure 'Top Market Revenue' =
			
			CALCULATE(
			    [Total Revenue],
			    KEEPFILTERS(TOPN(1, VALUES(Dim_Geography[Market]), [Total Revenue], DESC))
			)
		formatString: 0
		displayFolder: 01 Base Metrics
		lineageTag: 84cb407e-e3f1-4e56-9b5c-798965722ffc

	measure 'Top Product Name' =
			
			MAXX(
			    TOPN(1, VALUES(Dim_Product[Product]), [Net Profit], DESC),
			    Dim_Product[Product]
			)
		displayFolder: 03 Dynamic Text & Cards
		lineageTag: dc45c820-d5f2-4d54-9de1-83a1d7d7f5ca

	measure 'Top Product Profit' =
			
			CALCULATE([Net Profit], KEEPFILTERS(TOPN(1, VALUES(Dim_Product[Product]), [Net Profit], DESC)))
		formatString: 0
		displayFolder: 01 Base Metrics
		lineageTag: a739c805-d0d3-422f-8143-240835726447

	measure Total_Revenue_Text =
			
			FORMAT([Total Revenue] / 1000, "$#,##0.0K", "en-US")
		displayFolder: 03 Dynamic Text & Cards
		lineageTag: eb14782d-2a6d-4ddb-bc29-a91c13165b0f

		changedProperty = IsHidden

	measure Top_Market_Revenue_Text =
			
			FORMAT([Top Market Revenue] / 1000, "$#,##0.0K", "en-US")
		displayFolder: 03 Dynamic Text & Cards
		lineageTag: c6eebdb1-dd8c-4054-a405-90d9f8a84a87

	measure 'Revenue YoY Formatted' = ```
			
			VAR IsYearFiltered = HASONEVALUE('Dim_Calendar'[Year])
			VAR MaxSalesDate = MAX('Fact_Sales'[Date])
			VAR CurrentYear = YEAR(MaxSalesDate)
			
			VAR CurrentVal = 
			    IF(
			        IsYearFiltered,
			        [Total Revenue],
			        CALCULATE([Total Revenue], 'Dim_Calendar'[Year] = CurrentYear)
			    )
			
			VAR PreviousVal = 
			    IF(
			        IsYearFiltered,
			        CALCULATE([Total Revenue], SAMEPERIODLASTYEAR('Dim_Calendar'[Date])),
			        CALCULATE([Total Revenue], 'Dim_Calendar'[Year] = CurrentYear - 1)
			    )
			
			VAR YoY = DIVIDE(CurrentVal - PreviousVal, PreviousVal, BLANK())
			VAR YearLabel = IF(NOT IsYearFiltered, " (" & CurrentYear & " vs " & (CurrentYear - 1) & ")", " YoY")
			
			RETURN
			IF(
			    ISBLANK(YoY),
			    "",
			    SWITCH(
			        TRUE(),
			        ABS(YoY) < 0.0005, "► 0.0%" & YearLabel,
			        YoY > 0, "▲ " & FORMAT(YoY, "0.0%", "en-US") & YearLabel,
			        "▼ " & FORMAT(ABS(YoY), "0.0%", "en-US") & YearLabel
			    )
			)
			```
		displayFolder: 02 Time Intelligence
		lineageTag: e40ac83b-5eec-4aec-82be-dd6231a8ba9b

	measure Lowest_Margin_ProductLine =
			
			MAXX(
			    TOPN(1, VALUES(Dim_Product[Product Line]), [Gross Margin %], ASC),
			    Dim_Product[Product Line]
			)
		displayFolder: 03 Dynamic Text & Cards
		lineageTag: c8275a1a-7e9a-47c0-b24d-5dd2af21ea6f

	measure Lowest_Margin_Pct =
			
			CALCULATE(
			    [Gross Margin %],
			    KEEPFILTERS(TOPN(1, VALUES(Dim_Product[Product Line]), [Gross Margin %], ASC))
			)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 03 Dynamic Text & Cards
		lineageTag: 1129b584-2c7f-4c05-9549-4cfaea9387ae

	measure Highest_Margin_Pct =
			
			CALCULATE(
			    [Gross Margin %],
			    KEEPFILTERS(TOPN(1, VALUES(Dim_Product[Product Line]), [Gross Margin %], DESC))
			)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 03 Dynamic Text & Cards
		lineageTag: 9cfe99d0-1524-4206-813a-ae12adbe69b6

	measure Top_Product_Profit_Text =
			
			VAR TopProdProfit = CALCULATE([Net Profit], KEEPFILTERS(TOPN(1, VALUES(Dim_Product[Product]), [Net Profit], DESC)))
			RETURN
			FORMAT(TopProdProfit / 1000, "$#,##0.0K", "en-US")
		displayFolder: 03 Dynamic Text & Cards
		lineageTag: 9c766697-2f8a-487e-8ab4-b516a3b22517

	measure 'Total Revenue' = SUM(Fact_Sales[Sales])
		formatString: \$#,0.0;(\$#,0.0);\$#,0.0
		displayFolder: 01 Base Metrics
		lineageTag: 00ea8fcf-3247-4040-9ef6-34d3d34c1173

		changedProperty = IsHidden

	measure 'Market Color Accent' = ```
			
			VAR MaxRevenueInContext = 
			    CALCULATE(
			        MAXX(
			            VALUES('Dim_Geography'[Market]), 
			            [Total Revenue]
			        ), 
			        ALLSELECTED('Dim_Geography')
			    )
			VAR CurrentCategoryRevenue = [Total Revenue]
			RETURN 
			    IF(
			        CurrentCategoryRevenue = MaxRevenueInContext, 
			        "#008080",
			        "#314F62"
			    )
			```
		displayFolder: 04 Formatting & Colors
		lineageTag: 828c2d4a-e4d9-447d-ad7d-db2b73bd4ac4

	measure 'COGS YoY Formatted' = ```
			
			VAR IsYearFiltered = HASONEVALUE('Dim_Calendar'[Year])
			VAR MaxSalesDate = MAX('Fact_Sales'[Date])
			VAR CurrentYear = YEAR(MaxSalesDate)
			
			VAR CurrentVal = 
			    IF(
			        IsYearFiltered,
			        [Total COGS],
			        CALCULATE([Total COGS], 'Dim_Calendar'[Year] = CurrentYear)
			    )
			
			VAR PreviousVal = 
			    IF(
			        IsYearFiltered,
			        CALCULATE([Total COGS], SAMEPERIODLASTYEAR('Dim_Calendar'[Date])),
			        CALCULATE([Total COGS], 'Dim_Calendar'[Year] = CurrentYear - 1)
			    )
			
			VAR YoY = DIVIDE(CurrentVal - PreviousVal, PreviousVal, BLANK())
			VAR YearLabel = IF(NOT IsYearFiltered, " (" & CurrentYear & " vs " & (CurrentYear - 1) & ")", " YoY")
			
			RETURN
			IF(
			    ISBLANK(YoY),
			    "",
			    SWITCH(
			        TRUE(),
			        ABS(YoY) < 0.0005, "► 0.0%" & YearLabel,
			        YoY > 0, "▲ " & FORMAT(YoY, "0.0%", "en-US") & YearLabel,
			        "▼ " & FORMAT(ABS(YoY), "0.0%", "en-US") & YearLabel
			    )
			)
			```
		displayFolder: 02 Time Intelligence
		lineageTag: 261dae9a-502a-4fe1-8f35-0478476974da

	measure 'COGS YoY Color' =
			
			VAR YoYText = [COGS YoY Formatted]
			RETURN
			    SWITCH(
			        TRUE(),
			        CONTAINSSTRING(YoYText, "►"), "#6B7280",
			        CONTAINSSTRING(YoYText, "▲"), "#E63946",
			        CONTAINSSTRING(YoYText, "▼"), "#2CCE2C",
			        "#6B7280"
			    )
		displayFolder: 04 Formatting & Colors
		lineageTag: 46a2b96c-c48b-4c5c-952a-5335e0a48ca2

