	measure Low_Margin_Outliers_Names = ```
			
			VAR Outliers = 
			    CALCULATETABLE(
			        VALUES('Dim_Product'[Product]),
			        FILTER('Dim_Product', [Gross Margin %] < 0.45)
			    )
			RETURN
			IF(
			    COUNTROWS(Outliers) > 0,
			    CONCATENATEX(Outliers, 'Dim_Product'[Product], ", "),
			    "None"
			)
			```
		displayFolder: 03 Dynamic Text & Cards
		lineageTag: 4fe99aba-769e-47a8-969c-999486998714

	measure Lowest_Outlier_Margin_Pct = ```
			
			VAR MinVal = 
			    MINX(
			        FILTER('Dim_Product', [Gross Margin %] < 0.45),
			        [Gross Margin %]
			    )
			RETURN
			IF(
			    NOT ISBLANK(MinVal),
			    FORMAT(MinVal, "0.0%", "en-US"),
			    "45.0%"
			)
			```
		displayFolder: 03 Dynamic Text & Cards
		lineageTag: 70ee2e93-d907-4649-874c-036102dc898e

	partition _Measures = m
		mode: import
		source =
				let
				  Źródło = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [#"Kolumna 1" = _t]),
				    #"Usunięto kolumny" = Table.RemoveColumns(Źródło,{"Kolumna 1"})
				in
				  #"Usunięto kolumny"

	annotation PBI_NavigationStepName = Nawigacja

	annotation PBI_ResultType = Table

