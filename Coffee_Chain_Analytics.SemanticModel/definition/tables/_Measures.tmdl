	measure Lowest_Margin_GrossProfit =
			
			VAR LowestCategory = [Lowest_Margin_ProductLine]
			RETURN
			CALCULATE(
			    [Gross Profit],
			    'Dim_Product'[Product Line] = LowestCategory
			)
		formatString: 0
		displayFolder: 01 Base Metrics
		lineageTag: c898c193-3f1e-4caa-9678-636f11ef63cf

